{
  "name": "simple-video-editor",
  "productName": "Simple Video Editor",
  "version": "1.0.0",
  "description": "A tiny video editor for Windows: trim, cut, and drop clips into gaps.",
  "private": true,
  "main": "src/main.js",
  "license": "MIT",
  "author": "Simple Video Editor",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.simplevideoeditor",
    "productName": "Simple Video Editor",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "SimpleVideoEditor-${version}-windows.${ext}"
    },
    "portable": {
      "artifactName": "SimpleVideoEditor-${version}-portable.exe"
    }
  }
}
